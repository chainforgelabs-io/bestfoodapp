# Copy to .env or .env.development and fill in values. Do not commit real secrets.
MONGODB_URI=mongodb+srv://user:pass@cluster/dbname
JWT_SECRET=change-me

# Optional: S3 for photo uploads and private receipts
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=your-app-bucket
# S3_RECEIPTS_BUCKET=
# If S3_RECEIPTS_BUCKET is unset, receipts use S3_BUCKET_NAME. For production,
# prefer a separate private bucket, or a bucket policy denying public s3:GetObject
# on the receipts/ object prefix.
#
# Receipt OCR autofill uses AWS Textract (AnalyzeExpense) and reuses the same
# AWS_REGION + credentials above. The IAM user/role needs Textract permission
# (e.g. attach the AmazonTextractFullAccess policy). If credentials are missing,
# receipt scanning is skipped gracefully and users fill the review manually.

# CDN_BASE_URL=https://cdn.example.com
