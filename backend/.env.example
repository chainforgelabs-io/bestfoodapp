# Copy to .env or .env.development and fill in values. Do not commit real secrets.

# --- Required for core API ---
MONGODB_URI=mongodb+srv://user:pass@cluster/dbname
JWT_SECRET=change-me

# --- Server ---
# PORT=5000
# NODE_ENV=development

# --- Frontend URL (password-reset email links) ---
# FRONTEND_URL=http://localhost:3000

# --- Email (Nodemailer / password reset) ---
# EMAIL_USER=you@example.com
# EMAIL_PASS=app-password-or-smtp-secret

# --- Optional: S3 for photo uploads and private receipts ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=your-app-bucket
# S3_RECEIPTS_BUCKET=
# If S3_RECEIPTS_BUCKET is unset, receipts use S3_BUCKET_NAME. For production,
# prefer a separate private bucket, or a bucket policy denying public s3:GetObject
# on the receipts/ object prefix.
#
# Receipt OCR autofill uses AWS Textract (AnalyzeExpense) and reuses the same
# AWS_REGION + credentials above. The IAM user/role needs Textract permission
# (e.g. attach the AmazonTextractFullAccess policy). If credentials are missing,
# receipt scanning is skipped gracefully and users fill the review manually.

# CDN_BASE_URL=https://cdn.example.com

# --- Optional: xAI Grok vision for admin menu photo import ---
# Get a key from https://console.x.ai/ — Cursor chat access is not this key.
# XAI_API_KEY=
# XAI_MODEL=grok-2-vision-1212
# XAI_BASE_URL=https://api.x.ai/v1

# --- Optional: Meta (Instagram / Facebook) social publishing + token cron ---
# META_LONG_LIVED_TOKEN=
# META_APP_ID=
# META_APP_SECRET=
# IG_BUSINESS_ACCOUNT_ID=
# FB_PAGE_ID=
# FB_PAGE_ACCESS_TOKEN=
# CRON_SECRET=

# --- Optional: X / Twitter publishing ---
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
