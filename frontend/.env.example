# Copy to frontend/.env and fill in values. Do not commit real secrets.

# Local API origin (CRA proxies/calls this in development)
REACT_APP_API_BASE_URL=http://localhost:5000

# Google Maps JavaScript API key (Places / maps pages)
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional: silence CRA CI treat-warnings-as-errors locally
# CI=false
