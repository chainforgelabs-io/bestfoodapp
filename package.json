{
  "name": "food-ranking-app",
  "version": "1.0.0",
  "description": "Best Food App — city-scoped food rankings (Chain Forge Labs portfolio demo)",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "cd backend && npm run start",
    "build": "ls -la && cd frontend && npm install && npm run build",
    "dev": "concurrently \"cd backend && npm run start:dev\" \"cd frontend && npm start\"",
    "places:import-cities": "node backend/lib/places/scripts/importCities.js",
    "places:import": "node backend/lib/places/scripts/importPlaces.js",
    "places:resync": "node backend/lib/places/scripts/resyncPlaces.js",
    "seo:backfill-slugs": "node backend/lib/seo/scripts/backfillRestaurantSlugs.js",
    "seo:test-sitemap": "node backend/lib/seo/__tests__/sitemap.invariant.test.js"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/nearest-point": "^7.3.5",
    "@vercel/analytics": "^1.5.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongodb": "^6.8.0",
    "mongoose": "^8.5.4",
    "nodemailer": "^6.9.15",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
