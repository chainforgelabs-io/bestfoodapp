{
  "version": 2,
  "buildCommand": "ls -la && pwd && npm run build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/assets/social/**"
    },
    "api/render.js": {
      "includeFiles": "frontend/build/index.html"
    },
    "api/sitemap.js": {
      "includeFiles": "backend/models/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh-meta-token",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/seo-maintenance",
      "schedule": "0 6 * * *"
    }
  ],
  "routes": [
    {
      "src": "/sw\\.js$",
      "dest": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))$",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(manifest\\.json|sw\\.js|favicon\\.ico|robots\\.txt|llms\\.txt)$",
      "dest": "/$1"
    },
    {
      "src": "/sitemap\\.xml$",
      "dest": "/api/sitemap"
    },
    {
      "src": "/api/cron/(.*)",
      "dest": "/api/cron/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api?path=$1"
    },
    {
      "src": "^/(city|leaderboards|restaurant|scoring-criteria|feed|map|badge|best)(/.*)?$",
      "dest": "/api/render"
    },
    {
      "src": "^/$",
      "dest": "/api/render"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
