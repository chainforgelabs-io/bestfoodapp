{
  "version": 2,
  "buildCommand": "ls -la && pwd && npm run build",
  "outputDirectory": "frontend/build",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(manifest\\.json|sw\\.js|favicon\\.ico|robots\\.txt|.*\\.(png|jpg|jpeg|gif|css|js)$)",
      "dest": "/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api?path=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
